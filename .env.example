# AWS Configuration
AWS_REGION=af-south-1
AWS_ACCOUNT_ID=your-account-id

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514
BEDROCK_REGION=us-east-1

# Database
DYNAMODB_TABLE_PREFIX=eadpa-
DYNAMODB_SESSIONS_TABLE=eadpa-sessions
DYNAMODB_PIPELINES_TABLE=eadpa-pipelines
DYNAMODB_EXECUTIONS_TABLE=eadpa-executions

# S3
S3_ARTIFACTS_BUCKET=eadpa-artifacts
S3_CODE_BUCKET=eadpa-generated-code

# Auth
AUTH_SECRET=change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
